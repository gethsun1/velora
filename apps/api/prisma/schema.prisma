generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  CUSTOMER
  ADMIN
  STAFF
}

enum BookingStatus {
  SUBMITTED
  AWAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  ARRIVING
  SETUP_IN_PROGRESS
  ACTIVE
  COLLECTION_SCHEDULED
  OUT_FOR_COLLECTION
  COLLECTED
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PENDING
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID
  REFUND_PENDING
  REFUNDED
  DEPOSIT_HELD
  DEPOSIT_RELEASED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  PREPARING
  DISPATCHED
  AT_CUSTOMER
  COLLECTION_DUE
  RETURNED
  CLEANING
  MAINTENANCE
  DAMAGED
  LOST
  RETIRED
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  passwordHash  String
  type          UserType         @default(CUSTOMER)
  active        Boolean          @default(true)
  firstName     String
  lastName      String
  phone         String?
  roles         UserRole[]
  refreshTokens RefreshToken[]
  customer      CustomerProfile?
  staff         StaffProfile?
  auditLogs     AuditLog[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  key   String           @unique
  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model CustomerProfile {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String?           @unique @db.Uuid
  user      User?             @relation(fields: [userId], references: [id])
  name      String
  phone     String            @unique
  email     String?
  addresses CustomerAddress[]
  bookings  Booking[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CustomerAddress {
  id         String          @id @default(uuid()) @db.Uuid
  customerId String          @db.Uuid
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zoneId     String          @db.Uuid
  zone       ServiceZone     @relation(fields: [zoneId], references: [id])
  building   String
  landmark   String?
  notes      String?
  createdAt  DateTime        @default(now())
}

model StaffProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  user        User                @relation(fields: [userId], references: [id])
  available   Boolean             @default(true)
  assignments BookingAssignment[]
}

model ServiceZone {
  id           String            @id @default(uuid()) @db.Uuid
  name         String            @unique
  slug         String            @unique
  deliveryFee  Int
  setupFee     Int
  minimumOrder Int               @default(0)
  lateNight    Boolean           @default(true)
  active       Boolean           @default(true)
  addresses    CustomerAddress[]
  bookings     Booking[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ExperiencePackage {
  id             String                 @id @default(uuid()) @db.Uuid
  name           String
  slug           String                 @unique
  description    String
  basePrice      Int
  includedSetups Int                    @default(1)
  includedHours  Int                    @default(3)
  active         Boolean                @default(true)
  featuredOrder  Int                    @default(0)
  durations      PackageDurationPrice[]
  bookings       Booking[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model PackageDurationPrice {
  id        String            @id @default(uuid()) @db.Uuid
  packageId String            @db.Uuid
  package   ExperiencePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hours     Int
  price     Int

  @@unique([packageId, hours])
}

model FlavourCategory {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  flavours Flavour[]
}

model Flavour {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  slug         String           @unique
  description  String
  tastingNotes String
  surcharge    Int              @default(0)
  stock        Int              @default(20)
  active       Boolean          @default(true)
  categoryId   String           @db.Uuid
  category     FlavourCategory  @relation(fields: [categoryId], references: [id])
  bookings     BookingFlavour[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AddOn {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  slug      String         @unique
  price     Int
  active    Boolean        @default(true)
  bookings  BookingAddOn[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Booking {
  id              String                 @id @default(uuid()) @db.Uuid
  reference       String                 @unique
  trackingPin     String
  customerId      String                 @db.Uuid
  customer        CustomerProfile        @relation(fields: [customerId], references: [id])
  packageId       String                 @db.Uuid
  package         ExperiencePackage      @relation(fields: [packageId], references: [id])
  zoneId          String                 @db.Uuid
  zone            ServiceZone            @relation(fields: [zoneId], references: [id])
  status          BookingStatus          @default(SUBMITTED)
  paymentStatus   PaymentStatus          @default(UNPAID)
  setups          Int
  durationHours   Int
  deliveryAt      DateTime
  eventType       String
  guestCount      Int
  locationType    String
  addressSnapshot Json
  pricingSnapshot Json
  total           Int
  notes           String?
  flavours        BookingFlavour[]
  addOns          BookingAddOn[]
  history         BookingStatusHistory[]
  reservations    InventoryReservation[]
  assignments     BookingAssignment[]
  payments        Payment[]
  deposits        Deposit[]
  extensions      BookingExtension[]
  consents        ConsentRecord[]
  notifications   Notification[]
  dispatchJobs    DispatchJob[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, deliveryAt])
  @@index([customerId])
}

model BookingFlavour {
  bookingId         String  @db.Uuid
  flavourId         String  @db.Uuid
  quantity          Int     @default(1)
  surchargeSnapshot Int
  booking           Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  flavour           Flavour @relation(fields: [flavourId], references: [id])

  @@id([bookingId, flavourId])
}

model BookingAddOn {
  bookingId     String  @db.Uuid
  addOnId       String  @db.Uuid
  quantity      Int     @default(1)
  priceSnapshot Int
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn         AddOn   @relation(fields: [addOnId], references: [id])

  @@id([bookingId, addOnId])
}

model BookingStatusHistory {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status    BookingStatus
  note      String?
  createdAt DateTime      @default(now())
}

model BookingExtension {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  hours     Int
  amount    Int
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BookingAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  bookingId String       @db.Uuid
  staffId   String       @db.Uuid
  booking   Booking      @relation(fields: [bookingId], references: [id])
  staff     StaffProfile @relation(fields: [staffId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([bookingId, staffId])
}

model InventoryCategory {
  id     String           @id @default(uuid()) @db.Uuid
  name   String           @unique
  assets InventoryAsset[]
}

model InventoryAsset {
  id               String                 @id @default(uuid()) @db.Uuid
  code             String                 @unique
  name             String
  categoryId       String                 @db.Uuid
  category         InventoryCategory      @relation(fields: [categoryId], references: [id])
  status           InventoryStatus        @default(AVAILABLE)
  condition        String                 @default("Excellent")
  replacementValue Int
  location         String                 @default("Velora Hub")
  cleaningStatus   String                 @default("Clean")
  notes            String?
  reservations     InventoryReservation[]
  maintenance      InventoryMaintenance[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model InventoryReservation {
  id         String         @id @default(uuid()) @db.Uuid
  assetId    String         @db.Uuid
  bookingId  String         @db.Uuid
  asset      InventoryAsset @relation(fields: [assetId], references: [id])
  booking    Booking        @relation(fields: [bookingId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  releasedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([assetId, startsAt, endsAt])
}

model InventoryMaintenance {
  id          String         @id @default(uuid()) @db.Uuid
  assetId     String         @db.Uuid
  asset       InventoryAsset @relation(fields: [assetId], references: [id])
  note        String
  cost        Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  booking   Booking       @relation(fields: [bookingId], references: [id])
  amount    Int
  method    String
  status    PaymentStatus
  reference String?
  createdAt DateTime      @default(now())
}

model Deposit {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  booking   Booking       @relation(fields: [bookingId], references: [id])
  amount    Int
  status    PaymentStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model DispatchJob {
  id         String                @id @default(uuid()) @db.Uuid
  bookingId  String                @db.Uuid
  booking    Booking               @relation(fields: [bookingId], references: [id])
  type       String
  status     String
  proof      DeliveryProof?
  inspection CollectionInspection?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model DeliveryProof {
  id              String      @id @default(uuid()) @db.Uuid
  jobId           String      @unique @db.Uuid
  job             DispatchJob @relation(fields: [jobId], references: [id])
  confirmationPin String?
  imageUrl        String?
  createdAt       DateTime    @default(now())
}

model CollectionInspection {
  id        String      @id @default(uuid()) @db.Uuid
  jobId     String      @unique @db.Uuid
  job       DispatchJob @relation(fields: [jobId], references: [id])
  condition String
  notes     String?
  createdAt DateTime    @default(now())
}

model DamageReport {
  id          String   @id @default(uuid()) @db.Uuid
  assetCode   String
  description String
  amount      Int      @default(0)
  createdAt   DateTime @default(now())
}

model Promotion {
  id           String                @id @default(uuid()) @db.Uuid
  code         String                @unique
  type         String
  value        Int
  minimumOrder Int                   @default(0)
  active       Boolean               @default(true)
  startsAt     DateTime
  endsAt       DateTime
  redemptions  PromotionRedemption[]
}

model PromotionRedemption {
  id               String    @id @default(uuid()) @db.Uuid
  promotionId      String    @db.Uuid
  promotion        Promotion @relation(fields: [promotionId], references: [id])
  bookingReference String
  amount           Int
  createdAt        DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id])
  channel   String
  event     String
  recipient String
  message   String
  status    String   @default("LOGGED")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model BusinessSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model ConsentRecord {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type      String
  accepted  Boolean
  version   String
  createdAt DateTime @default(now())
}
