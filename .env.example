# Frontend demo requires no secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
DEMO_MODE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/velora
JWT_ACCESS_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_ADMIN_EMAIL=admin@veloraexperience.co.ke
SEED_DEMO_ADMIN_PASSWORD=change-me-locally
NOTIFICATION_PROVIDER=mock
PAYMENT_PROVIDER=manual
UPLOAD_PROVIDER=disabled
